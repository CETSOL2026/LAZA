# Copy to .env and adjust for your machine. All variables are optional —
# the API falls back to the defaults shown here when unset.

# SQL Server instance and database the indicator API reads from.
LAZA_SQL_INSTANCE=.\SQLEXPRESS
LAZA_SQL_DATABASE=LAZA_DATA_PLATFORM_DEV

# Full path to sqlcmd.exe.
LAZA_SQLCMD=C:\Program Files\Microsoft SQL Server\Client SDK\ODBC\170\Tools\Binn\SQLCMD.EXE

# Port the local indicator API listens on.
LAZA_API_PORT=8790

# Port used only by the API contract test suite (server/test/).
LAZA_TEST_API_PORT=8795

# Path to the Admin Panel credential file (PBKDF2 salt + hash only, no
# clear-text password). See docs/ADMIN_ACCESS.md.
LAZA_ADMIN_AUTH_CONFIG=D:\LAZA_DATA\config\laza-admin-auth.json
